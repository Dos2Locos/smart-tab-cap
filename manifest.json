{
  "manifest_version": 3,
  "name": "Smart Tab Cap",
  "version": "1.9.0",
  "description": "Reuse existing tabs and limit the number of open tabs.",
  "permissions": [
    "tabs",
    "tabGroups",
    "sessions",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Tab Cap"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
